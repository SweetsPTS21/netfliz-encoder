# ===== Application Configuration =====
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ===== AWS S3 Configuration =====
BACKBLAZE_S3_ENDPOINT=your_backblaze_endpoint
BACKBLAZE_S3_REGION=your_backblaze_region
BACKBLAZE_S3_BUCKET_NAME=your_bucket_name
BACKBLAZE_S3_APPLICATION_KEY=your_application_key
BACKBLAZE_S3_APPLICATION_KEY_ID=your_application_key_id
BACKBLAZE_S3_WORKER_SHARED_SECRET=your_worker_shared_secret

# ===== Video Processing =====
TEMP_DIR=/tmp/video-processing
FFMPEG_PATH=/usr/bin/ffmpeg

# ===== Database Configuration =====
SPRING_DATASOURCE_URL=your_database_url
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# ===== JWT Configuration =====
APPLICATION_SECURITY_JWT_SECRET_KEY=your_jwt_secret_key
APPLICATION_SECURITY_JWT_EXPIRATION=86400000
APPLICATION_SECURITY_JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ===== CORS Configuration =====
SPRING_CORS_ALLOWED_ORIGIN_PATTERNS=your_allowed_origins

# ===== CDN Configuration =====
PROXY_CDN_STREAM_URL=your_cdn_stream_url

# ===== Redis Configuration =====
SPRING_DATA_REDIS_HOST=your_redis_host
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=your_redis_username
SPRING_DATA_REDIS_PASSWORD=your_redis_password

# ===== Kafka Configuration =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== Video Quality Configuration =====
# 1080p
VIDEO_QUALITY_1080P_NAME=1080p
VIDEO_QUALITY_1080P_WIDTH=1920
VIDEO_QUALITY_1080P_HEIGHT=1080
VIDEO_QUALITY_1080P_VIDEO_BITRATE=5000k
VIDEO_QUALITY_1080P_AUDIO_BITRATE=192k

# 720p
VIDEO_QUALITY_720P_NAME=720p
VIDEO_QUALITY_720P_WIDTH=1280
VIDEO_QUALITY_720P_HEIGHT=720
VIDEO_QUALITY_720P_VIDEO_BITRATE=3000k
VIDEO_QUALITY_720P_AUDIO_BITRATE=128k

# 480p
VIDEO_QUALITY_480P_NAME=480p
VIDEO_QUALITY_480P_WIDTH=854
VIDEO_QUALITY_480P_HEIGHT=480
VIDEO_QUALITY_480P_VIDEO_BITRATE=1500k
VIDEO_QUALITY_480P_AUDIO_BITRATE=128k

# 360p
VIDEO_QUALITY_360P_NAME=360p
VIDEO_QUALITY_360P_WIDTH=640
VIDEO_QUALITY_360P_HEIGHT=360
VIDEO_QUALITY_360P_VIDEO_BITRATE=800k
VIDEO_QUALITY_360P_AUDIO_BITRATE=96k
